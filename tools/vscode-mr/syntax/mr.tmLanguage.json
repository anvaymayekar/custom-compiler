{
    "scopeName": "source.mr",

    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#functions" }
    ],

    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.mr",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.mr",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.mr",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.mr", "match": "\\\\." }
                    ]
                },
                {
                    "name": "string.quoted.single.mr",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        { "name": "constant.character.escape.mr", "match": "\\\\." }
                    ]
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.mr",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "comment": "Declaration modifiers: he/te (singular/collection), maze (private), sthir (static), sarve, lahan/maha/uch (size), ahe (immutable)",
                    "name": "storage.modifier.mr",
                    "match": "\\b(he|te|maze|sthir|sarve|lahan|maha|uch|ahe)\\b"
                },

                {
                    "comment": "Basic types",
                    "name": "storage.type.mr",
                    "match": "\\b(ank|akshar|bhagank|purnank|vidhan|nirank|agyat)\\b"
                },

                {
                    "comment": "Conditional control flow: jar (if), nahitar (else-if), anyatha (else), paryay (switch)",
                    "name": "keyword.control.conditional.mr",
                    "match": "\\b(jar|nahitar|anyatha|paryay)\\b"
                },

                {
                    "comment": "Loop / flow-transfer control flow",
                    "name": "keyword.control.flow.mr",
                    "match": "\\b(jovar|pratyek|thamba|pudhe|partav)\\b"
                },

                {
                    "comment": "Object-oriented / type-system vocabulary",
                    "name": "keyword.other.oop.mr",
                    "match": "\\b(varg|rachna|navin|vishes|prakar)\\b"
                },

                {
                    "comment": "Exceptions and modules",
                    "name": "keyword.control.exception.mr",
                    "match": "\\b(prayatna|apvaad|ayat)\\b"
                },

                {
                    "name": "keyword.operator.logical.word.mr",
                    "match": "\\b(ani|va)\\b"
                },

                {
                    "name": "constant.language.boolean.mr",
                    "match": "\\b(khare|khote)\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.mr",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.increment-decrement.mr",
                    "match": "\\+\\+|--"
                },
                {
                    "name": "keyword.operator.assignment.compound.mr",
                    "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
                },
                {
                    "name": "keyword.operator.bitwise.mr",
                    "match": "<<|>>|&|\\||\\^|~"
                },
                {
                    "name": "keyword.operator.logical.symbol.mr",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.mr",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.assignment.mr",
                    "match": "="
                }
            ]
        },

        "functions": {
            "patterns": [
                {
                    "comment": "Built-in program-level operations: leeh (print), shevti (exit), karya (function keyword)",
                    "name": "support.function.mr",
                    "match": "\\b(leeh|shevti|karya)\\b"
                },
                {
                    "name": "entity.name.function.mr",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        }
    }
}
