// ============================================================
// .mr LANGUAGE TORTURE TEST
// Exercises:
// declarations, modifiers, constants, static storage,
// all primitive types, functions, recursion, scopes,
// conditionals, while, for, switch, break, continue,
// arithmetic, comparison, logical, bitwise,
// compound assignment, increment/decrement,
// strings, characters, floats, booleans,
// comments and nested scopes.
// ============================================================


// ------------------------------------------------------------
// BASIC DECLARATIONS
// ------------------------------------------------------------

ank integer = 42;
he ank explicitInteger = 100;

bhagank decimal = 3.14159;
purnank unsignedValue = 500;

vidhan ready = khare;
vidhan finished = khote;

he akshar letter = 'A';
te akshar name = "Anvay";


// ------------------------------------------------------------
// DECLARATION MODIFIERS
// ------------------------------------------------------------

he ank smallValue = 10;
he lahan ank small = 20;
he maha ank large = 30;
he uch ank huge = 40;

he maze ank privateLike = 50;

ank immutable ahe 99;


// ------------------------------------------------------------
// BASIC EXPRESSIONS
// ------------------------------------------------------------

ank arithmetic =
10 + 20 * 3 - 8 / 2;

ank precedence =
(10 + 20) * 3;

ank remainder =
17 % 5;


// ------------------------------------------------------------
// ASSIGNMENT OPERATORS
// ------------------------------------------------------------

ank compound = 10;

compound += 5;
compound -= 2;
compound *= 3;
compound /= 2;
compound %= 4;

compound &= 7;
compound |= 2;
compound ^= 1;
compound <<= 1;
compound >>= 1;


// ------------------------------------------------------------
// INCREMENT / DECREMENT
// ------------------------------------------------------------

ank counter = 0;

counter++;

counter--;

ank postfix = counter++;


// ------------------------------------------------------------
// COMPARISON + BOOLEAN LOGIC
// ------------------------------------------------------------

vidhan equalTest = (10 == 10);
vidhan notEqualTest = (10 != 20);
vidhan lessTest = (5 < 10);
vidhan greaterTest = (10 > 5);
vidhan lessEqualTest = (5 <= 5);
vidhan greaterEqualTest = (10 >= 10);

vidhan logicalAnd = equalTest && lessTest;
vidhan logicalOr = equalTest || finished;
vidhan logicalNot = !finished;

vidhan marathiAnd = ready ani !finished;
vidhan marathiOr = ready va finished;


// ------------------------------------------------------------
// BITWISE OPERATORS
// ------------------------------------------------------------

ank bitAnd = 12 & 10;
ank bitOr = 12 | 10;
ank bitXor = 12 ^ 10;
ank bitNot = ~12;

ank shiftLeft = 3 << 4;
ank shiftRight = 48 >> 3;


// ------------------------------------------------------------
// STRING CONCATENATION
// ------------------------------------------------------------

te akshar firstName = "Anvay";
te akshar lastName = "Mayekar";

te akshar fullName =
firstName + " " + lastName;


// ------------------------------------------------------------
// FUNCTIONS
// ------------------------------------------------------------

ank karya add(he ank a, he ank b) {
    partav a + b;
}

bhagank karya multiplyFloat(
he bhagank a,
he bhagank b
) {
    partav a * b;
}

te akshar karya greeting(te akshar who) {
    partav "Namaskar, " + who;
}

akshar karya firstCharacter(te akshar text) {
    partav 'M';
}

nirank karya doNothing() {
    partav;
}


// ------------------------------------------------------------
// STATIC VARIABLE
// ------------------------------------------------------------

ank karya nextId() {

    sthir ank id = 0;

    id += 1;

    partav id;
}


// ------------------------------------------------------------
// RECURSION
// ------------------------------------------------------------

he ank karya factorial(he ank n) {

    jar (n <= 1) {
        partav 1;
    }

    partav n * factorial(n - 1);
}


// ------------------------------------------------------------
// IF / ELSE IF / ELSE
// ------------------------------------------------------------

ank score = 75;

jar (score >= 90) {

    leeh(1);

} nahitar (score >= 75) {

    leeh(2);

} nahitar (score >= 50) {

    leeh(3);

} anyatha {

    leeh(4);
}


// ------------------------------------------------------------
// WHILE
// ------------------------------------------------------------

ank i = 0;

jovar (i < 3) {

    leeh(i);

    i++;
}


// ------------------------------------------------------------
// FOR + CONTINUE + BREAK
// ------------------------------------------------------------

pratyek (
he ank j = 0;
j < 10;
j++
) {

    jar (j == 2) {
        pudhe;
    }

    jar (j == 6) {
        thamba;
    }

    leeh(j);
}


// ------------------------------------------------------------
// SWITCH
// ------------------------------------------------------------

ank day = 2;

paryay (day) {

    1:
    leeh(101);

    2:
    leeh(202);

    3:
    leeh(303);

    anyatha:
    leeh(999);
}


// ------------------------------------------------------------
// NESTED SCOPES / SHADOWING
// ------------------------------------------------------------

ank outer = 100;

{

    ank inner = 200;

    leeh(outer);
    leeh(inner);

    {
        ank deepest = 300;

        leeh(outer);
        leeh(inner);
        leeh(deepest);

        // Shadow outer variable inside deeper scope.
        ank outer = 400;

        leeh(outer);
    }

    leeh(outer);
}


// ------------------------------------------------------------
// SCOPE INSIDE CONDITIONAL
// ------------------------------------------------------------

jar (ready) {

    ank scopedValue = 123;

    leeh(scopedValue);

    {
        ank nestedValue = 456;

        leeh(scopedValue);
        leeh(nestedValue);
    }
}


// ------------------------------------------------------------
// FUNCTION CALLS
// ------------------------------------------------------------

leeh(add(20, 22));

leeh(multiplyFloat(2.5, 4.0));

leeh(greeting("Anvay"));

leeh(firstCharacter("Marathi"));

doNothing();


// ------------------------------------------------------------
// STATIC STORAGE TEST
// ------------------------------------------------------------

leeh(nextId());
leeh(nextId());
leeh(nextId());


// ------------------------------------------------------------
// RECURSION TEST
// ------------------------------------------------------------

leeh(factorial(5));


// ------------------------------------------------------------
// MIXED EXPRESSIONS
// ------------------------------------------------------------

ank complex =
((10 + 5) * 4 - 6) / 2;

jar (
(complex > 20)
ani (complex != 30)
va ready
) {

    leeh(complex);

}


// ------------------------------------------------------------
// CHARACTER / STRING / FLOAT OUTPUT
// ------------------------------------------------------------

leeh(letter);
leeh(name);
leeh(fullName);
leeh(decimal);


// ------------------------------------------------------------
// FINAL RESULT
// ------------------------------------------------------------

shevti(0);