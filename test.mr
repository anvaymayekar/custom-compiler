// Jai Maharashtra

te akshar name ahe "Newton's Cooling";        // ahe    -> immutable

he bhagank roomTemp ahe 25.0;                 // bhagank -> float
he bhagank temperature = 90.0;                // =      -> mutable
he bhagank rate ahe 0.1;
he ank time = 0;                              // ank    -> integer
he vidhan reached = khote;                    // vidhan -> boolean

he maze bhagank karya cool(                   // maze   -> private
    he bhagank temperature,
    he bhagank roomTemp,
    he bhagank rate
) {
    partav temperature - rate * (temperature - roomTemp); // partav -> return
}

jovar (!reached ani time < 10) {              // jovar -> while | ani -> and
    temperature = cool(temperature, roomTemp, rate);
    time++;

    jar (temperature <= 50.0) {               // jar -> if
        reached = khare;
    }
}

jar (reached) {
    leeh(name);
    leeh("Tapman 50 peksha kami ahe:");
} anyatha {                                   // anyatha -> else
    leeh("Ajun thand hot ahe:");
}

leeh(temperature);                            // leeh -> print