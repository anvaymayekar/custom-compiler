he maze vidhan karya isPrime(he ank x){
    he vidhan prime = khare;
    jar (x <= 1){
        partav khote;
    }
    pratyek (he ank i = 2; i*i <= x; i++) {
        jar (x % i == 0){
            prime = khote;
            thamba;
        }
    }
    partav prime;
}

pratyek (he ank i = 2; i < 50; i++) {
    jar (isPrime(i)){
        leeh(i);
    }
}