// prefix as a bare statement
he ank i = 0;
++i;
--i;

// prefix as a for-step
pratyek (he ank j = 0; j < 5; ++j) { leeh(j); }

// sthir actually persisting across calls
he ank karya counter() {
    he sthir ank n = 0;
    partav n++;
}
leeh(counter());
leeh(counter());
leeh(counter());
leeh(counter());
