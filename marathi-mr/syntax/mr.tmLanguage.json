{
    "scopeName": "source.mr",

    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        }
    ],

    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.mr",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.mr",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.mr",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.mr",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.mr",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "name": "storage.modifier.mr",
                    "match": "\\b(he|te)\\b"
                },

                {
                    "name": "storage.type.mr",
                    "match": "\\b(ank|akshar)\\b"
                },

                {
                    "name": "keyword.control.conditional.mr",
                    "match": "\\b(jar|nahitar|anyatha)\\b"
                },

                {
                    "name": "keyword.control.flow.mr",
                    "match": "\\b(thamb|shevat)\\b"
                },

                {
                    "name": "keyword.operator.logical.mr",
                    "match": "\\b(ani|kiva)\\b"
                },

                {
                    "name": "constant.language.boolean.mr",
                    "match": "\\b(khare|khote)\\b"
                },

                {
                    "name": "keyword.other.state.mr",
                    "match": "\\b(ahe|ahet)\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.mr",
                    "match": "==|!=|<=|>=|<|>"
                },

                {
                    "name": "keyword.operator.arithmetic.mr",
                    "match": "\\+|-|\\*|/|%"
                },

                {
                    "name": "keyword.operator.assignment.mr",
                    "match": "="
                }
            ]
        },

        "functions": {
            "patterns": [
                {
                    "name": "support.function.mr",
                    "match": "\\bbol\\b"
                },

                {
                    "name": "entity.name.function.mr",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
                }
            ]
        }
    }
}
